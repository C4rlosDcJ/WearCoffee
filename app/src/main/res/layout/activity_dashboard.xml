<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sakura_gradient"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textColor="#5C5045"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvRepartidorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repartidor"
                android:textColor="#8C1F45"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPedidos"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_button"
            android:text="Ver Pedidos"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnSensores"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Ver Sensores"
            android:textColor="#8C1F45"
            android:textSize="12sp"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:backgroundTint="#dc3545"
            android:text="Salir"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
