<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sakura_gradient"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mis Pedidos"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Actualizar"
            android:textColor="#D9526B"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"
            android:layout_marginBottom="8dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />

        <!-- Mensaje de estado vacío -->
        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tienes pedidos asignados."
            android:textColor="#F4C2CB"
            android:textSize="11sp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Contenedor de Pedido Activo -->
        <LinearLayout
            android:id="@+id/containerActiveOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="10dp"
                android:gravity="center_horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvClientName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cliente: Juan Perez"
                    android:textColor="#4A2E2B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dirección: Av. Principal 123"
                    android:textColor="#6E4D48"
                    android:textSize="10sp"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Items: 2x Americano"
                    android:textColor="#6E4D48"
                    android:textSize="9sp"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: $120.00"
                    android:textColor="#D9526B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Acciones Propuesto/Ofrecido -->
            <LinearLayout
                android:id="@+id/containerProposalActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnAcceptOffer"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_button"
                    android:text="Aceptar Pedido"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnDeclineOffer"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_button_decline"
                    android:text="Rechazar"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>

            <!-- Acciones En Camino / Entregado -->
            <LinearLayout
                android:id="@+id/containerDeliveryActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="visible">

                <Button
                    android:id="@+id/btnStartRoute"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_button_start_route"
                    android:text="Empezar Ruta"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_marginBottom="6dp" />

                <Button
                    android:id="@+id/btnCompleteDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_button_complete"
                    android:text="Completar Entrega"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Volver"
            android:textColor="#D9526B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>
</ScrollView>
